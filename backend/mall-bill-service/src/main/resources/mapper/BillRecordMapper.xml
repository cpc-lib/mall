<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cc.ivera.bill.infrastructure.persistence.mapper.BillRecordMapper">

  <!-- 批次明细过滤条件：importId 必填，recordType 非空时过滤 -->
  <sql id="recordFilter">
    where import_id = #{importId}
    <if test="recordType != null and recordType != ''">
      and record_type = #{recordType}
    </if>
  </sql>

  <!-- 批次明细列表：id 升序 -->
  <select id="selectRecordsByImport" resultType="cc.ivera.bill.infrastructure.persistence.po.BillRecordPO">
    select *
    from t_bill_record
    <include refid="recordFilter"/>
    order by id asc
  </select>

  <select id="countRecordsByImport" resultType="java.lang.Long">
    select count(*)
    from t_bill_record
    <include refid="recordFilter"/>
  </select>

  <!-- 差异下钻定位渠道流水：业务单号与渠道流水号任一相等，空白条件不参与，按 id 升序 -->
  <select id="selectRecordsByImportAndMatch" resultType="cc.ivera.bill.infrastructure.persistence.po.BillRecordPO">
    select *
    from t_bill_record
    where import_id = #{importId}
    <if test="recordType != null and recordType != ''">
      and record_type = #{recordType}
    </if>
    <choose>
      <when test="(bizNo != null and bizNo != '') and (channelSerialNo != null and channelSerialNo != '')">
        and (biz_no = #{bizNo} or channel_serial_no = #{channelSerialNo})
      </when>
      <when test="bizNo != null and bizNo != ''">
        and biz_no = #{bizNo}
      </when>
      <when test="channelSerialNo != null and channelSerialNo != ''">
        and channel_serial_no = #{channelSerialNo}
      </when>
      <otherwise>
        and 1 = 0
      </otherwise>
    </choose>
    order by id asc
  </select>

  <!-- 批次明细分页：id 升序，limit/offset 由调用方按页计算 -->
  <select id="selectPageByImport" resultType="cc.ivera.bill.infrastructure.persistence.po.BillRecordPO">
    select *
    from t_bill_record
    <include refid="recordFilter"/>
    order by id asc
    limit #{limit} offset #{offset}
  </select>

</mapper>
