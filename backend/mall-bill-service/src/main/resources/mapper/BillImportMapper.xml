<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cc.ivera.bill.infrastructure.persistence.mapper.BillImportMapper">

  <!-- 显式列清单：与 BillImportPO 字段一一对应 -->
  <sql id="importColumns">
    id, import_no, channel_code, bill_type, bill_kind, bill_date, file_name, file_hash,
    total_record_count, pay_record_count, refund_record_count, bad_line_count,
    matched_count, discrepancy_count, status, reconcile_time, error_message, fence_token,
    create_time, update_time
  </sql>

  <!-- 导入批次过滤条件：billDate 非空时按账单日期过滤 -->
  <sql id="importFilter">
    <where>
      <if test="billDate != null and billDate != ''">
        and bill_date = #{billDate}
      </if>
    </where>
  </sql>

  <select id="countImportsByDate" resultType="java.lang.Long">
    select count(*)
    from t_bill_import
    <include refid="importFilter"/>
  </select>

  <!-- 导入批次分页：id 倒序，limit/offset 由调用方按页计算 -->
  <select id="selectPageByDate" resultType="cc.ivera.bill.infrastructure.persistence.po.BillImportPO">
    select <include refid="importColumns"/>
    from t_bill_import
    <include refid="importFilter"/>
    order by id desc
    limit #{limit} offset #{offset}
  </select>

</mapper>
