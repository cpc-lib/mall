<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cc.ivera.mapper.bill.BillImportMapper">

    <!-- 导入批次列表：billDate 非空时按账单日期过滤，id 倒序 -->
    <select id="selectImportsByDate" resultType="cc.ivera.entity.bill.BillImport">
        select *
        from t_bill_import
        <where>
            <if test="billDate != null and billDate != ''">
                and bill_date = #{billDate}
            </if>
        </where>
        order by id desc
    </select>

</mapper>
