<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cc.ivera.user.infrastructure.persistence.mapper.UserAccountMapper">

  <!-- 管理员用户列表总数：username 关键字模糊可选 -->
  <select id="countAdminUsers" resultType="java.lang.Long">
    select count(*)
    from t_user
    <where>
      <if test="keywordLike != null">
        and username like #{keywordLike}
      </if>
    </where>
  </select>

  <!-- 管理员用户列表分页：username 关键字模糊可选，id 升序，LIMIT/OFFSET 手动分页 -->
  <select id="selectAdminUsers" resultType="cc.ivera.user.infrastructure.persistence.po.UserAccountPO">
    select *
    from t_user
    <where>
      <if test="keywordLike != null">
        and username like #{keywordLike}
      </if>
    </where>
    order by id asc
    limit #{limit} offset #{offset}
  </select>

</mapper>
