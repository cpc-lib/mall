<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>cc.ivera</groupId>
  <artifactId>mall-backend</artifactId>
  <version>0.0.1-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>mall-backend</name>
  <description>商城后端聚合：mall-core 领域内核 + user/admin BFF + 网关</description>

  <modules>
    <module>mall-common</module>
    <module>mall-api-order</module>
    <module>mall-api-payment</module>
    <module>mall-api-refund</module>
    <module>mall-infra</module>
    <module>mall-api-user</module>
    <module>mall-api-cart</module>
    <module>mall-api-product</module>
    <module>mall-core</module>
    <module>mall-user-service</module>
    <module>mall-cart-service</module>
    <module>mall-product-service</module>
    <module>mall-payment-service</module>
    <module>mall-refund-service</module>
    <module>mall-order-service</module>
    <module>mall-bill-service</module>
    <module>mall-user-bff</module>
    <module>mall-admin-bff</module>
    <module>mall-gateway</module>
  </modules>

  <properties>
    <java.version>21</java.version>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    <spring-boot.version>3.5.16</spring-boot.version>
    <spring-cloud.version>2025.0.0</spring-cloud.version>
    <spring-cloud-alibaba.version>2025.0.0.0</spring-cloud-alibaba.version>
    <lombok.version>1.18.48</lombok.version>
    <mybatis-plus.version>3.5.18</mybatis-plus.version>
    <redisson.version>3.52.0</redisson.version>
    <springdoc.version>2.10.0</springdoc.version>
    <archunit.version>1.5.1</archunit.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-dependencies</artifactId>
        <version>${spring-boot.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.springframework.cloud</groupId>
        <artifactId>spring-cloud-dependencies</artifactId>
        <version>${spring-cloud.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>com.alibaba.cloud</groupId>
        <artifactId>spring-cloud-alibaba-dependencies</artifactId>
        <version>${spring-cloud-alibaba.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>cc.ivera</groupId>
        <artifactId>mall-common</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>cc.ivera</groupId>
        <artifactId>mall-api-order</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>cc.ivera</groupId>
        <artifactId>mall-api-payment</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>cc.ivera</groupId>
        <artifactId>mall-api-refund</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>cc.ivera</groupId>
        <artifactId>mall-infra</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>cc.ivera</groupId>
        <artifactId>mall-api-user</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>cc.ivera</groupId>
        <artifactId>mall-api-cart</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>cc.ivera</groupId>
        <artifactId>mall-api-product</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>cc.ivera</groupId>
        <artifactId>mall-core</artifactId>
        <version>${project.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.14.0</version>
        <configuration>
          <release>${maven.compiler.release}</release>
          <encoding>UTF-8</encoding>
          <parameters>true</parameters>
          <!-- JDK 23+ 默认关闭隐式注解处理，需显式声明 Lombok 处理器 -->
          <annotationProcessorPaths>
            <path>
              <groupId>org.projectlombok</groupId>
              <artifactId>lombok</artifactId>
              <version>${lombok.version}</version>
            </path>
          </annotationProcessorPaths>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.5.2</version>
        <configuration>
          <!-- 对账日切按 Asia/Shanghai 归账，测试 JVM 时区与之保持一致 -->
          <argLine>-Duser.timezone=Asia/Shanghai</argLine>
        </configuration>
      </plugin>
    </plugins>
  </build>

</project>
