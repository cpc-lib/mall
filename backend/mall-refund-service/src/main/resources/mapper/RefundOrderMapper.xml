<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cc.ivera.refund.infrastructure.persistence.mapper.RefundOrderMapper">

  <!-- 管理员退款列表分页：创建时间倒序，同时间按主键倒序保证翻页稳定 -->
  <select id="countAllRefundOrders" resultType="java.lang.Long">
    select count(*)
    from t_refund_order
  </select>

  <select id="selectPageCreateTimeDesc" resultType="cc.ivera.refund.infrastructure.persistence.po.RefundOrderPO">
    select *
    from t_refund_order
    order by create_time desc, id desc
    limit #{limit} offset #{offset}
  </select>

</mapper>
