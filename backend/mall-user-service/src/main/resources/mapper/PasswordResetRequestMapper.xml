<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cc.ivera.user.infrastructure.persistence.mapper.PasswordResetRequestMapper">

  <select id="countAllRequests" resultType="java.lang.Long">
    select count(*)
    from t_password_reset_request
  </select>

  <!-- 管理员列表分页：待处理优先，同状态按申请时间倒序，同时间按主键倒序保证翻页稳定 -->
  <select id="selectPagePendingFirst" resultType="cc.ivera.user.infrastructure.persistence.po.PasswordResetRequestPO">
    select *
    from t_password_reset_request
    order by case when status = 'PENDING' then 0 else 1 end, create_time desc, id desc
    limit #{limit} offset #{offset}
  </select>

</mapper>
